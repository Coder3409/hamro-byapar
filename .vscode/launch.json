{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Hamro Byapar",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
